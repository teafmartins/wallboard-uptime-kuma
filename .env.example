# ============================================================
# Kuma Wallboard v0.1
# Works both with Docker and directly with Node.js.
# ============================================================

# Public Wallboard port.
# Native mode: the backend listens directly on this port.
# Docker mode: this port is exposed on the host and mapped to 8080 in the container.
WALLBOARD_PORT=3002

# Base Uptime Kuma URL, without /status/...
# Example on a local network:
KUMA_URL=http://192.168.1.50:3001

# Option A: username/password
KUMA_USERNAME=admin
KUMA_PASSWORD=change-me

# Option B: token (when supported/configured, it takes precedence)
# KUMA_TOKEN=

# Maximum number of heartbeats kept in memory per monitor.
MAX_HISTORY=500

# The options below normally do NOT need to be defined.
# PORT takes precedence over WALLBOARD_PORT and is used internally by Docker.
# PORT=3002
# DASHBOARD_CONFIG=C:\path\to\config\dashboard.json
# ASSETS_DIR=C:\path\to\assets
# WEB_DIST=C:\path\to\web\dist
